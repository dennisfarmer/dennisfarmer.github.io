<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css">

  <link rel="icon" href="/favicon.ico" type="image/x-icon"/>
  <!--
  Webamp - Implementation of Winamp in HTML5 and Javascript
  https://github.com/captbaritone/webamp
  -->
  <script defer src="https://unpkg.com/webamp@1.4.0/built/webamp.bundle.min.js"></script>

  <!--
  Javascript for toggling light/dark mode
  -->
  <!--
  Theme init. Runs before first paint and applies the class to <html>, so a
  light-mode reload never flashes dark. The CSS keys off html.light-mode.
  -->
  <script>
  (function() {
    var theme = localStorage.getItem('theme');
    if (!theme) {
      theme = 'dark'; // Default to dark mode
      localStorage.setItem('theme', theme);
    }
    document.documentElement.classList.toggle('light-mode', theme === 'light');
  })();
  </script>
</head>
<body class="{{ section }}">
  <script>
    function toggleLightMode() {
      var isLightMode = document.documentElement.classList.toggle("light-mode");
      localStorage.setItem("theme", isLightMode ? "light" : "dark");
    }
  </script>
  {% include "components/header.njk" %}
  <main  class="{{ section }}{% if leftalign %} leftalign{% endif %}">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}

  <!-- Webamp will attempt to center itself within this div -->
  <div id="winamp-container" hidden></div>
  <script>
    // Lazily builds the player on first toggle, then just shows/hides it.
    // The bundle is deferred, so this only ever runs on a real click.
    (function() {
      var webamp = null;

      window.toggleWinamp = function() {
        var button = document.getElementById("winamp-toggle");
        var container = document.getElementById("winamp-container");
        if (!container) return;

        if (webamp) {
          container.hidden = !container.hidden;
          if (button) {
            button.textContent = container.hidden ? "🔇" : "🔊";
            button.setAttribute("aria-pressed", container.hidden ? "false" : "true");
          }
          return;
        }

        if (typeof window.Webamp === "undefined") return; // bundle not ready yet

        container.hidden = false;
        webamp = new window.Webamp({
          initialTracks: [
            {
              metaData: {
                artist: "Hello Meteor",
                title: "The House of the Sun",
              },
              url: "/music/HelloMeteor_TheHouseoftheSun.mp3"
            },
            {
              metaData: {
                artist: "Hello Meteor",
                title: "Rushing Green",
              },
              url: "/music/HelloMeteor_RushingGreen.mp3"
            },
            {
              metaData: {
                artist: "Hello Meteor",
                title: "South Shore Rain",
              },
              url: "/music/HelloMeteor_SouthShoreRain.mp3"
            },
          ],
          initialSkin: {
            url: "/webamp/base-2.91.wsz"
          },
          container: container,
        });
        // Returns a promise indicating when it's done loading.
        webamp.renderWhenReady(container);

        if (button) {
          button.textContent = "🔊";
          button.setAttribute("aria-pressed", "true");
        }
      };
    })();
  </script>
</body>
</html>
